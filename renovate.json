{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "prHourlyLimit": 5,
  "prConcurrentLimit": 10,
  "automergeType": "pr",
  "platformAutomerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Helm charts from standard registries",
      "managerFilePatterns": [
        "/charts/.+/values\\.yaml$/"
      ],
      "matchStrings": [
        "version: [\"']?(?<currentValue>[^\"'\\s]+)[\"']?\\n(?:\\s+\\S+:[^\\n]*\\n){0,3}\\s+repoURL: (?<registryUrl>https://[^\\n]+)\\n\\s+chart: (?<depName>[^\\n\\s]+)"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "description": "Helm charts from OCI registries",
      "managerFilePatterns": [
        "/charts/.+/values\\.yaml$/"
      ],
      "matchStrings": [
        "version: [\"']?(?<currentValue>[^\"'\\s]+)[\"']?\\n(?:\\s+\\S+:[^\\n]*\\n){0,3}\\s+repoURL: oci://(?<depName>[^\\n]+)\\n\\s+path: \\."
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Istio gateway chart version in shared values",
      "managerFilePatterns": [
        "/charts/shared/values\\.yaml$/"
      ],
      "matchStrings": [
        "gateway:\\n\\s+enabled: (?:true|false)\\n\\s+version: (?<currentValue>[^\\n\\s]+)"
      ],
      "depNameTemplate": "gateway",
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://blob.istio.io/istio-release/charts"
    }
  ],
  "packageRules": [
    {
      "description": "Istio components must always stay in sync regardless of update type",
      "groupName": "istio",
      "matchPackageNames": [
        "base",
        "istiod",
        "gateway"
      ],
      "matchDatasources": [
        "helm"
      ]
    },
    {
      "description": "MariaDB operator + CRDs must always stay in sync",
      "groupName": "mariadb-operator",
      "matchPackageNames": [
        "mariadb-operator",
        "mariadb-operator-crds"
      ],
      "matchDatasources": [
        "helm"
      ]
    },
    {
      "description": "Require review unless an image update matches the minor/patch rule below",
      "matchDatasources": [
        "helm",
        "docker"
      ],
      "automerge": false
    },
    {
      "description": "Merge container image minor and patch updates after CI passes",
      "matchDatasources": ["docker"],
      "matchManagers": ["helm-values", "woodpecker"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Docker images (minor and patch)",
      "groupSlug": "dockerimages-minor-patch",
      "automerge": true
    },
    {
      "description": "Replace latest tags with pinned versions",
      "matchCurrentValue": "latest",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "description": "Skip the published DNS operator chart with an invalid default image (HOMEIT-510)",
      "matchDatasources": [
        "helm"
      ],
      "matchPackageNames": [
        "dns-operator"
      ],
      "allowedVersions": "!/^0\\.0\\.10$/"
    }
  ]
}
